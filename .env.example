# ==============================================================================
# DentalAI - Environment Variables Template
# Copy this file to .env and insert your real credentials.
# ==============================================================================

# Application Environment
APP_NAME=DentalAI
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PROJECT_REF=<your-project-ref>

# Client-facing / Public keys (Frontend)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_ANON_KEY=eyJ...

# Server-side Secret keys (Backend only - KEEP SECRET)
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage Bucket Name
SUPABASE_STORAGE_BUCKET=xray-scans
# Auth: access tokens are verified against the project's public JWKS. Only projects still on the
# legacy shared JWT secret (HS256) need this:
SUPABASE_JWT_SECRET=
SIGNED_URL_TTL_SECONDS=3600
MAX_UPLOAD_MB=20

# ------------------------------------------------------------------------------
# AI Microservice Configuration (dentex_week3)
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8001
ML_TIMEOUT_SECONDS=60
ML_DEFAULT_CONFIDENCE=0.20

# ------------------------------------------------------------------------------
# Backend API Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Frontend Vite Environment Variables
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_API_URL=http://localhost:8000
VITE_API_V1_PREFIX=/api/v1


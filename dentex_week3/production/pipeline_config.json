{
  "architecture": "tooth_detector_plus_disease_detector",
  "tooth_model": "tooth_best.pt",
  "disease_model": "disease_best.pt",
  "tooth_imgsz": 1024,
  "disease_imgsz": 1024,
  "tooth_conf": 0.25,
  "disease_conf": 0.25,
  "disease_map": {
    "0": "Impacted",
    "1": "Caries",
    "2": "Periapical Lesion",
    "3": "Deep Caries"
  },
  "tooth_map": {
    "1": "Tooth_1",
    "2": "Tooth_2",
    "3": "Tooth_3",
    "4": "Tooth_4",
    "5": "Tooth_5",
    "6": "Tooth_6",
    "7": "Tooth_7",
    "8": "Tooth_8"
  },
  "association": "iou_then_center_containment_then_nearest_center",
  "training": {
    "tooth": {
      "dataset": "quadrant_enumeration",
      "train_images": 540,
      "val_images": 94,
      "classes": 32,
      "notebook": "notebooks/03_train_tooth_detector.ipynb"
    },
    "disease": {
      "dataset": "quadrant-enumeration-disease",
      "train_images": 598,
      "val_images": 107,
      "classes": 4,
      "notebook": "notebooks/04_train_disease_detector.ipynb"
    }
  },
  "evaluation": {
    "harness": "dentex_week3/evaluate.py",
    "locked_set": "official DENTEX validation, 50 images / 182 lesions",
    "v1_baseline": {
      "mAP50": 0.498,
      "precision": 0.409,
      "recall": 0.566,
      "disease_accuracy": 0.836,
      "tooth_accuracy": 0.759,
      "joint_accuracy": 0.664
    }
  }
}

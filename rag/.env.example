# Choose LLM Provider: groq, openrouter, gemini, openai, or ollama
LLM_PROVIDER=groq

# Groq API Key (Get a free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Get a free key at https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# LLM_PROVIDER=openrouter

# Google Gemini API Key (Get a free key at https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_PROVIDER=gemini

# Remote Ollama Server URL (If running Ollama on another server/machine)
# OLLAMA_URL=http://<REMOTE_IP>:11434/api/generate
# LLM_PROVIDER=ollama

# Environment variables
.env
.env.local
.env.*.local
*.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Python build dirs. These MUST stay anchored to the repo root: a bare `lib/` also matched
# frontend/src/lib/ and silently kept the frontend's typed API client out of git (never committed,
# so a fresh clone could not build). Never use a bare directory name for a Python pattern here.
/lib/
/lib64/
**/venv/lib/
**/venv/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
# NOTE: patterns with a trailing slash match directories only, so a symlink
# named `venv` slipped through as a file (commit ac930a2). Bare patterns catch
# directories, files, and symlinks alike.
venv
ENV
env
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Node.js / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# React build
/build
/dist
/.next
.cache

# Frontend source (never ignore it): this directory holds the typed API client, and a bare
# Python `lib/` pattern once swallowed it. Kept as an explicit guard against a repeat.
!frontend/src/lib/

# Testing
.coverage
.pytest_cache/
htmlcov/
.tox/
.hypothesis/

# Jupyter Notebook
.ipynb_checkpoints


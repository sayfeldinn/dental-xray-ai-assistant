!/backend/
!/dentex_week3/
!/deploy/
**/venv/
**/.venv/
**/__pycache__/
**/*.pt
**/.pytest_cache/
backend/tests/
dentex_week3/eval/
dentex_week3/tests/
dentex_week3/feedback/

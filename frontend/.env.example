# Normally read from the repo-root .env (vite.config.ts sets envDir to ".."). Only VITE_* reach the browser.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable/anon key. Safe in the browser ONLY because the clinical tables have no client
# policies (supabase/migrations/20261020_auth_lockdown.sql). Never put the service-role key here.
VITE_SUPABASE_ANON_KEY=
